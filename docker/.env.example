# AgentGov + AgentScope Runtime 容器配置示例。
# 复制为 docker/.env 后，把所有 replace-with-* 值改为私有值；不要提交 docker/.env。

# Compose 与端口
COMPOSE_PROJECT_NAME=agent-gov
CONTAINER_NAME_PREFIX=agent-gov
HOST_RUNTIME_VOLUME_ROOT=${HOME}/volume-agent-gov
RUNTIME_BOOTSTRAP_HOST_DIR=./runtime-bootstrap
API_BIND_IP=127.0.0.1
API_ALLOW_PUBLIC_BIND=0
HOST_PORT=50400
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_ALLOW_PUBLIC_BIND=0
FRONTEND_HOST_PORT=50401
FRONTEND_PORT=5173
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info
API_KEY=replace-with-private-api-key
AGENTGOV_API_MODE=open
FRONTEND_RUNTIME_API_BASE=http://localhost:50400
FRONTEND_RUNTIME_API_KEY=replace-with-private-api-key

# AgentScope-only Runtime。provider 凭据只会由 Compose 注入 agentscope-runtime。
# AgentGov API 与 AgentScope Runtime 双向内部请求的共享密钥，用于 HMAC-SHA256 签名校验，验证请求来源和内容完整性。
# API 与 Runtime 必须使用同一个值；Compose 会将本项同时注入两个服务。
# 首次 make setup/up/all-up 自动生成并写入本私有文件，无需手工填写；有效旧值保持不变。
# 已有运行数据却缺失此值时，先恢复原密钥；不要生成新值冒充恢复。
# 本项独立于 API_KEY 和 MODEL_PROVIDER_API_KEY；真实值仅保存在私有 env，禁止提交或下发前端。
AGENTGOV_RUNTIME_SHARED_SECRET=
MODEL_PROVIDER_API_KEY=replace-with-private-provider-key
# 按客户端协议填写 base_url：DeepSeek OpenAI 兼容接口使用 https://api.deepseek.com。
# 若改用 Anthropic 兼容接口，填写 https://api.deepseek.com/anthropic，
# 并将 AGENTSCOPE_MODEL_TYPE、AGENTSCOPE_CREDENTIAL_TYPE 同步设为 anthropic_credential。
# 此处填写基础地址，不要填写完整的 /chat/completions 或 /messages 请求路径。
MODEL_PROVIDER_API_URL=https://api.deepseek.com
AGENTSCOPE_MODEL_TYPE=openai_credential
AGENTSCOPE_CREDENTIAL_TYPE=openai_credential
AGENTSCOPE_CREDENTIAL_ID=agentgov-runtime-provider
AGENTSCOPE_MODEL_NAME=deepseek-chat
AGENTSCOPE_MODEL_PARAMETERS_JSON={}
AGENT_GOV_RUNTIME_UID=1000
AGENT_GOV_RUNTIME_GID=1000
GOVERNANCE_AGENT_TIMEOUT_SECONDS=300
AGENT_TEST_RUN_TIMEOUT_SECONDS=1800

# MCP 凭据只会由 Compose 注入 agentscope-runtime。
MCP_SERVER_URL=http://host.docker.internal:58001/mcp
SEC_OPS_MCP_URL=http://host.docker.internal:58001/mcp
# 内置本机 sec-ops MCP 不要求 token；如已发布 Harness 显式声明认证，再配置对应私有凭据。
# SEC_OPS_MCP_TOKEN=

# Agent Harness Git 与候选发布目录
AGENT_GIT_SERVICE_PROVIDER=local
AGENT_GIT_SERVICE_URL=
AGENT_GIT_SERVICE_PUBLIC_URL=
AGENT_GIT_REPOSITORY_NAME=security-operations-expert-config

# Langfuse 查询与 AgentScope OTel 写入共用开关和一对项目 key。
# 首次自托管：复制本文件后运行 make langfuse-env，一次生成下面的私有凭据。
# 已有部署沿用原值；初始化不轮换已有凭据。不要重新生成已有数据使用的 SALT/ENCRYPTION_KEY。
# 核心三服务默认不启用观测；需要自托管 Langfuse 时在私有 docker/.env 中改为 true，
# 先运行 make langfuse-env，再运行 make all-up。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=replace-with-private-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-private-langfuse-secret-key
LANGFUSE_INIT_USER_EMAIL=admin@example.local
LANGFUSE_INIT_USER_PASSWORD=replace-with-private-langfuse-password
LANGFUSE_SALT=replace-with-private-langfuse-salt
LANGFUSE_ENCRYPTION_KEY=replace-with-64-lowercase-hex-characters
LANGFUSE_NEXTAUTH_SECRET=replace-with-private-nextauth-secret
LANGFUSE_POSTGRES_PASSWORD=replace-with-private-postgres-password
LANGFUSE_CLICKHOUSE_PASSWORD=replace-with-private-clickhouse-password
LANGFUSE_REDIS_AUTH=replace-with-private-redis-password
LANGFUSE_MINIO_ROOT_PASSWORD=replace-with-private-minio-password
# 普通配置默认由 Compose/Runtime 提供，仅需自定义时取消注释。
# LANGFUSE_HOST_PORT=50402              # 登录 URL 与前端入口随端口自动派生
# LANGFUSE_BASE_URL=http://langfuse-web:3000  # 容器查询与 OTLP 入口同源
# LANGFUSE_NEXTAUTH_URL=https://trace.example.com  # 反向代理公开地址
# LANGFUSE_INIT_PROJECT_ID=agent-gov    # 已有非默认项目保留 ID，前端链接同步使用
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# 更多覆盖项、外部 Langfuse 和安全边界见 README「Langfuse 与 OTel」。

# 可选代理；留空表示直连。
NO_PROXY=
no_proxy=
