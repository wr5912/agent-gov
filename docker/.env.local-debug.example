# AgentGov API 本机调试配置。AgentScope Runtime 仍应独立启动；本文件不保存 provider/MCP 凭据。
API_HOST=127.0.0.1
API_BIND_IP=127.0.0.1
API_ALLOW_PUBLIC_BIND=0
API_PORT=8080
HOST_PORT=50400
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_ALLOW_PUBLIC_BIND=0
LOG_LEVEL=debug
API_KEY=replace-with-local-debug-api-key
AGENTGOV_API_MODE=open
HOST_RUNTIME_VOLUME_ROOT=/tmp/local-debug-volume-agent-gov
DATA_DIR=/tmp/local-debug-volume-agent-gov/data
GOVERNOR_WORKSPACE_DIR=/tmp/local-debug-volume-agent-gov/governor-workspace
RUNTIME_CANDIDATES_DIR=/tmp/local-debug-volume-agent-gov/agentscope-runtime/candidates
AGENTSCOPE_RUNTIME_URL=http://127.0.0.1:8090
AGENTGOV_RUNTIME_SHARED_SECRET=replace-with-at-least-32-random-characters
AGENTSCOPE_MODEL_TYPE=openai_credential
AGENTSCOPE_CREDENTIAL_ID=agentgov-runtime-provider
AGENTSCOPE_MODEL_NAME=deepseek-chat
AGENTSCOPE_MODEL_PARAMETERS_JSON={}
GOVERNANCE_AGENT_TIMEOUT_SECONDS=300
AGENT_TEST_RUN_TIMEOUT_SECONDS=1800
AGENT_GIT_SERVICE_PROVIDER=local
AGENT_GIT_SERVICE_URL=
AGENT_GIT_SERVICE_PUBLIC_URL=
AGENT_GIT_REPOSITORY_NAME=security-operations-expert-config
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://127.0.0.1:50402
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
NO_PROXY=
no_proxy=
