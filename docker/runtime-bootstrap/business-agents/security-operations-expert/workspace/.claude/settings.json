{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Skill",
      "Task(response-playbook-planning)",
      "Task(response-playbook-builder)",
      "Edit(/data/outputs/security-operations-expert/**)",
      "Write(/data/outputs/security-operations-expert/**)"
    ],
    "ask": [],
    "deny": [
      "AskUserQuestion",
      "Read",
      "Glob",
      "Grep",
      "Bash",
      "WebFetch",
      "WebSearch",
      "mcp__*",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.mcp.json)",
      "Read(./.mcp.*.json)",
      "Read(./.claude/settings.json)",
      "Read(./.claude/settings.*.json)",
      "Read(/data/business-agents/security-operations-expert/claude-root/.claude.json)",
      "Read(/data/business-agents/security-operations-expert/claude-root/.claude/projects/**)",
      "Edit(./.mcp.json)",
      "Write(./.mcp.json)",
      "NotebookEdit(./.mcp.json)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "NotebookEdit(./CLAUDE.md)",
      "Edit(./agent.yaml)",
      "Write(./agent.yaml)",
      "NotebookEdit(./agent.yaml)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "NotebookEdit(./.claude/**)",
      "Edit(./hooks/**)",
      "Write(./hooks/**)",
      "NotebookEdit(./hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/hooks/pre_tool_guard.py\"",
            "timeout": 10,
            "statusMessage": "保护业务 Agent 治理文件"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/hooks/session_start.py\"",
            "timeout": 5,
            "statusMessage": "加载安全运营会话提示"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "allowWrite": [
        "/data/outputs/security-operations-expert"
      ],
      "denyRead": [
        "./**",
        "/data/uploads/**",
        "/data/business-agents/security-operations-expert/claude-root/**"
      ]
    },
    "network": {
      "allowedDomains": [],
      "deniedDomains": ["*"]
    },
    "allowUnsandboxedCommands": false
  },
  "spinnerTipsOverride": {
    "excludeDefault": false,
    "tips": [
      "安全运营先区分事实、推断和行动。",
      "Agent 只读取授权证据并形成响应方案，不执行 SOC 动作。",
      "所有系统变更由平台在独立权限与审批边界内完成。"
    ]
  },
  "includeGitInstructions": false
}
