{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Skill",
      "Read(/**/business-agents/*/workspace/CLAUDE.md)",
      "Read(/**/business-agents/*/workspace/.claude/skills/*/SKILL.md)",
      "Read(/**/business-agents/*/workspace/.claude/agents/*.md)",
      "Read(/**/business-agents/*/workspace/.claude/rules/*.md)",
      "Read(/**/business-agents/*/workspace/.claude/commands/*.md)"
    ],
    "ask": [],
    "deny": [
      "AskUserQuestion",
      "Write",
      "Edit",
      "NotebookEdit",
      "Bash",
      "WebFetch",
      "WebSearch",
      "mcp__*",
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/**/secrets/**)",
      "Read(/**/.mcp.json)",
      "Read(/**/.mcp.*.json)",
      "Read(/**/.claude/settings.json)",
      "Read(/**/.claude/settings.*.json)",
      "Read(/**/CLAUDE.local.md)",
      "Read(/**/claude-root/**)",
      "Read(/**/claude-roots/**)",
      "Read(/**/version/**)",
      "Read(/**/.git/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "enableWeakerNestedSandbox": false,
    "filesystem": {
      "allowWrite": [],
      "denyRead": [
        "**/.env",
        "**/.env.*",
        "**/secrets",
        "**/.mcp.json",
        "**/.mcp.*.json",
        "**/.claude/settings.json",
        "**/.claude/settings.*.json",
        "**/CLAUDE.local.md",
        "**/claude-root",
        "**/claude-roots",
        "**/version",
        "**/.git"
      ]
    },
    "network": {
      "allowedDomains": [],
      "deniedDomains": [
        "*"
      ]
    },
    "allowUnsandboxedCommands": false
  },
  "includeGitInstructions": false
}
