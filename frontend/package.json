{
  "name": "agent-gov-ui",
  "private": true,
  "version": "4.0.0",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "generate:api-types": "../.venv/bin/python ../scripts/export_openapi.py --output /tmp/agent-gov-openapi.json && openapi-typescript /tmp/agent-gov-openapi.json -o src/types/api.ts",
    "test:unit": "vitest run",
    "test:browser-audit-unit": "cd .. && node --test scripts/improvement_ui_e2e/*.test.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "verify:playwright-runtime": "cd .. && node scripts/verify_playwright_runtime.mjs",
    "verify:design-parity": "cd .. && node scripts/verify_improvement_ui_design_parity.mjs",
    "verify:real-container": "cd .. && make ui-feedback-smoke",
    "verify:real-container:impl": "cd .. && node scripts/verify_improvement_ui_real_container.mjs",
    "verify:improvement-decision": "cd .. && node scripts/verify_improvement_decision_ui.mjs",
    "verify:asset-registry": "cd .. && node scripts/verify_asset_registry.mjs",
    "verify:remote-api-base": "cd .. && node scripts/verify_remote_api_base.mjs",
    "verify:playground-cancel": "cd .. && node scripts/verify_playground_cancel.mjs"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/view": "^6.43.4",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "latest",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.60.0",
    "vitest": "^4.1.10"
  }
}
