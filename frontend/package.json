{
  "name": "agent-gov-ui",
  "private": true,
  "version": "4.0.1",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "generate:api-types": "../.venv/bin/python ../scripts/export_openapi.py --output /tmp/agent-gov-openapi.json && openapi-typescript /tmp/agent-gov-openapi.json -o src/types/api.ts",
    "generate:agentscope-types": "../.venv/bin/python ../scripts/agentscope_native_contract.py --write && openapi-typescript --default-non-nullable false ../config/agentscope_openapi.json -o src/types/agentscope.ts",
    "generate:types": "pnpm run generate:api-types && pnpm run generate:agentscope-types",
    "test:unit": "vitest run",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check:playwright-install": "cd .. && node scripts/check_playwright_install.mjs",
    "verify:design-parity": "cd .. && make ui-design-parity",
    "verify:real-container": "cd .. && make ui-feedback-smoke",
    "verify:real-container:impl": "cd .. && node scripts/verify_improvement_ui_real_container.mjs",
    "verify:improvement-decision": "cd .. && make ui-feedback-smoke",
    "verify:playground-cancel": "cd .. && make ui-playground-cancel-smoke",
    "verify:playground-cancel:impl": "cd .. && node scripts/verify_playground_cancel.mjs",
    "verify:agent-candidate": "cd .. && make ui-agent-candidate-technical-smoke",
    "verify:agent-candidate:impl": "cd .. && node scripts/verify_agent_candidate_lifecycle.mjs"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/view": "^6.43.4",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "latest",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.14.5",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.60.0",
    "vitest": "^4.1.10"
  }
}
