#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
DEFAULT_HOST="172.16.112.232"
DEFAULT_REMOTE_DIR="~/work/agent-gov"
COMPOSE_FILE="docker/docker-compose.yml"
LOCAL_COMPOSE_ENV_FILE="${LOCAL_COMPOSE_ENV_FILE:-docker/.env}"
DEPLOY_REF="${DEPLOY_REF:-origin/master}"
TRUSTED_DOCKER_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

usage() {
  cat <<'USAGE'
Usage: scripts/deploy_agent_gov_to_host [host]

Deploy an explicit committed Git ref to a remote Docker Compose host.

Defaults:
  host        172.16.112.232
  user        root          (override with DEPLOY_USER)
  remote dir  ~/work/agent-gov (override with REMOTE_DIR)
  source ref  origin/master    (override with DEPLOY_REF; must resolve locally)

The script preserves the remote private docker/.env, stores image archives in
remote images/, loads the images on the remote host, replaces this Compose
project, starts the core stack and locally configured Langfuse, and validates
the selected endpoints. External Langfuse needs no local storage credentials.
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if (( $# > 1 )); then
  usage >&2
  exit 2
fi

DEPLOY_HOST="${1:-${DEPLOY_HOST:-$DEFAULT_HOST}}"
DEPLOY_USER="${DEPLOY_USER:-root}"
REMOTE_DIR="${REMOTE_DIR:-$DEFAULT_REMOTE_DIR}"
REMOTE="${DEPLOY_USER}@${DEPLOY_HOST}"
SSH_CONNECT_TIMEOUT="${SSH_CONNECT_TIMEOUT:-10}"
SSH_OPTIONS=(
  -o StrictHostKeyChecking=accept-new
  -o BatchMode=yes
  -o "ConnectTimeout=${SSH_CONNECT_TIMEOUT}"
)

log() {
  printf '[deploy] %s\n' "$*"
}

die() {
  printf '[deploy] ERROR: %s\n' "$*" >&2
  exit 1
}

quote() {
  printf '%q' "$1"
}

remote_run() {
  ssh "${SSH_OPTIONS[@]}" "$REMOTE" "$@"
}

rsync_ssh_command() {
  local command="ssh"
  local option
  for option in "${SSH_OPTIONS[@]}"; do
    command+=" $(quote "$option")"
  done
  printf '%s' "$command"
}

require_command() {
  local name=$1
  command -v "$name" >/dev/null 2>&1 || die "required command not found: $name"
}

resolve_deploy_ref() {
  git fetch origin master --prune --tags

  TARGET_COMMIT=$(git rev-parse --verify "${DEPLOY_REF}^{commit}") \
    || die "DEPLOY_REF does not resolve to a commit: $DEPLOY_REF"
  VERSION=$(git show "${TARGET_COMMIT}:VERSION" | tr -d '[:space:]')
  [[ -n "$VERSION" ]] || die "$DEPLOY_REF VERSION is empty"

  local current_script_hash target_script_hash
  current_script_hash=$(git hash-object scripts/deploy_agent_gov_to_host)
  target_script_hash=$(git rev-parse "${TARGET_COMMIT}:scripts/deploy_agent_gov_to_host") \
    || die "$DEPLOY_REF does not contain scripts/deploy_agent_gov_to_host"
  [[ "$current_script_hash" = "$target_script_hash" ]] || die \
    "the running deploy script differs from DEPLOY_REF; invoke the script from the exact target commit"
}

normalize_architecture() {
  case "$1" in
    amd64|x86_64) printf 'amd64\n' ;;
    arm64|aarch64) printf 'arm64\n' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

ensure_local_image() {
  local image=$1
  if "${LOCAL_DOCKER[@]}" image inspect "$image" >/dev/null 2>&1; then
    return 0
  fi
  die "required local image missing after images-prepare/build: $image"
}

dedupe_images() {
  local image
  declare -A seen=()
  for image in "$@"; do
    [[ -n "$image" ]] || continue
    if [[ -z "${seen[$image]+x}" ]]; then
      seen[$image]=1
      printf '%s\n' "$image"
    fi
  done
}

upload_image_archive() {
  local archive=$1
  shift
  local images=("$@")

  log "Writing remote image archive: images/$archive"
  "${LOCAL_DOCKER[@]}" save "${images[@]}" | gzip -1 | remote_run "bash -c 'set -euo pipefail
    remote_path=\$1
    archive=\$2
    mkdir -p \"\$remote_path/images\"
    cat > \"\$remote_path/images/\${archive}.tmp\"
    mv \"\$remote_path/images/\${archive}.tmp\" \"\$remote_path/images/\$archive\"
    sha256sum \"\$remote_path/images/\$archive\" > \"\$remote_path/images/\$archive.sha256\"
    ls -lh \"\$remote_path/images/\$archive\"
    cat \"\$remote_path/images/\$archive.sha256\"
  ' bash $(quote "$REMOTE_PATH") $(quote "$archive")"
}

cd "$ROOT_DIR"

for command_name in git docker gzip install rsync ssh tar; do
  require_command "$command_name"
done

[[ -f VERSION ]] || die "VERSION file not found"
[[ -f "$COMPOSE_FILE" ]] || die "$COMPOSE_FILE not found"

log "Consumer x Mode x Boundary: remote containers use docker/.env, runtime root stays on the remote host, secrets stay in private env files"
resolve_deploy_ref

TMP_DIR=$(mktemp -d /tmp/agent-gov-master.XXXXXX)
LOCAL_BOUNDARY_DIR=$(mktemp -d /tmp/agentgov-deploy-boundary.XXXXXX)
trap 'rm -rf -- "$TMP_DIR" "$LOCAL_BOUNDARY_DIR"' EXIT

log "Exporting ${DEPLOY_REF} ${TARGET_COMMIT}"
git archive "$TARGET_COMMIT" | tar -x -C "$TMP_DIR"

mapfile -t LOCAL_TOOLCHAIN < <(
  PYTHONPATH="$TMP_DIR" "$ROOT_DIR/.venv/bin/python" - "$LOCAL_BOUNDARY_DIR" <<'PY'
from pathlib import Path
import sys

from scripts.selected_env_source_snapshot import (
    COMPOSE_PLUGIN_ENV,
    DOCKER_CLI_ENV,
    prepare_docker_toolchain,
)

environment = prepare_docker_toolchain(Path(sys.argv[1]), include_buildx=False)
print(environment[DOCKER_CLI_ENV])
print(environment[COMPOSE_PLUGIN_ENV])
print(environment["DOCKER_CONFIG"])
print(environment["PATH"])
PY
)
(( ${#LOCAL_TOOLCHAIN[@]} == 4 )) || die "failed to materialize bound local Docker CLI/plugin"
LOCAL_DOCKER_BIN=${LOCAL_TOOLCHAIN[0]}
LOCAL_COMPOSE_PLUGIN=${LOCAL_TOOLCHAIN[1]}
LOCAL_DOCKER_CONFIG=${LOCAL_TOOLCHAIN[2]}
LOCAL_DOCKER_PATH=${LOCAL_TOOLCHAIN[3]}
[[ -x "$LOCAL_DOCKER_BIN" && -x "$LOCAL_COMPOSE_PLUGIN" ]] || die "bound local Docker CLI/plugin is not executable"
LOCAL_DOCKER=(env -i HOME="${HOME:?HOME is required}" DOCKER_CONFIG="$LOCAL_DOCKER_CONFIG" PATH="$LOCAL_DOCKER_PATH" DOCKER_HOST=unix:///var/run/docker.sock "$LOCAL_DOCKER_BIN")

if [[ "$LOCAL_COMPOSE_ENV_FILE" = /* ]]; then
  LOCAL_COMPOSE_ENV_PATH="$LOCAL_COMPOSE_ENV_FILE"
else
  LOCAL_COMPOSE_ENV_PATH="$ROOT_DIR/$LOCAL_COMPOSE_ENV_FILE"
fi

if [[ ! -f "$LOCAL_COMPOSE_ENV_PATH" ]]; then
  LOCAL_COMPOSE_ENV_PATH="$TMP_DIR/docker/.env.example"
  log "$LOCAL_COMPOSE_ENV_FILE not found; using origin/master docker/.env.example for local build interpolation"
fi
[[ -f "$LOCAL_COMPOSE_ENV_PATH" ]] || die "compose env file not found"

log "Checking remote prerequisites on $REMOTE"
remote_run "bash -s" <<'REMOTE_PREREQUISITES'
set -euo pipefail
command -v python3 >/dev/null || { echo "remote python3 is required" >&2; exit 1; }
[ -f /usr/bin/docker ] || [ -f /usr/local/bin/docker ] || { echo "trusted remote Docker CLI is required" >&2; exit 1; }
for plugin in \
  /usr/local/lib/docker/cli-plugins/docker-compose \
  /usr/local/libexec/docker/cli-plugins/docker-compose \
  /usr/lib/docker/cli-plugins/docker-compose \
  /usr/libexec/docker/cli-plugins/docker-compose; do
  [ ! -f "$plugin" ] || break
done
[ -f "$plugin" ] || { echo "trusted remote Docker Compose plugin is required" >&2; exit 1; }
python3 - <<'PY'
import sys

if sys.version_info < (3, 11):
    raise SystemExit(f"remote Python >=3.11 is required, found {sys.version.split()[0]}")
PY
REMOTE_PREREQUISITES

LOCAL_DOCKER_ARCH=$(normalize_architecture "$("${LOCAL_DOCKER[@]}" info --format '{{.Architecture}}')")
REMOTE_DOCKER_ARCH=$(normalize_architecture "$(remote_run "bash -s" <<'REMOTE_DOCKER_ARCH'
set -euo pipefail
trusted_path=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
boundary=$(mktemp -d /tmp/agentgov-deploy-docker-boundary.XXXXXX)
chmod 0700 "$boundary"
trap 'rm -rf -- "$boundary"' EXIT
source_cli=/usr/bin/docker
[ -f "$source_cli" ] || source_cli=/usr/local/bin/docker
[ -f "$source_cli" ] && [ ! -L "$source_cli" ] || { echo "trusted remote Docker CLI is invalid" >&2; exit 1; }
source_owner=$(stat -Lc '%u' "$source_cli")
source_mode=$(stat -Lc '%a' "$source_cli")
[ "$source_owner" = 0 ] && (( (8#$source_mode & 8#022) == 0 )) || { echo "trusted remote Docker CLI owner/mode is invalid" >&2; exit 1; }
source_sha=$(sha256sum "$source_cli" | awk '{print $1}')
install -m 0500 "$source_cli" "$boundary/docker"
[ "$(sha256sum "$source_cli" | awk '{print $1}')" = "$source_sha" ] || { echo "Docker CLI changed while binding" >&2; exit 1; }
[ "$(sha256sum "$boundary/docker" | awk '{print $1}')" = "$source_sha" ] || { echo "bound Docker CLI bytes differ" >&2; exit 1; }
env -i HOME="$HOME" DOCKER_CONFIG="$boundary" PATH="$trusted_path" DOCKER_HOST=unix:///var/run/docker.sock \
  "$boundary/docker" info --format '{{.Architecture}}'
REMOTE_DOCKER_ARCH
)")
[[ "$LOCAL_DOCKER_ARCH" = "$REMOTE_DOCKER_ARCH" ]] || die \
  "local Docker architecture $LOCAL_DOCKER_ARCH does not match remote $REMOTE_DOCKER_ARCH; docker save transfers only the resolved local platform"

REMOTE_PATH=$(remote_run "REMOTE_DIR=$(quote "$REMOTE_DIR") python3 - <<'PY'
import os

print(os.path.abspath(os.path.expanduser(os.environ['REMOTE_DIR'])))
PY
")
[[ -n "$REMOTE_PATH" ]] || die "failed to resolve remote path"

log "Remote path: $REMOTE:$REMOTE_PATH"
remote_run "mkdir -p $(quote "$REMOTE_PATH") $(quote "$REMOTE_PATH/images")"

# 在 rsync 覆盖旧栈 Compose/脚本之前，只读检查远程 schema epoch。临时 bundle 放在
# images/ 中（该目录不参与代码 rsync），携带应用与 cutover 共用的物理 schema inspector，
# 无论成功还是失败都删除。
log "Preflighting remote Runtime epoch before source sync"
PREFLIGHT_ROOT=$(remote_run "mktemp -d $(quote "$REMOTE_PATH/images/.agentscope-cutover-preflight.XXXXXX")")
case "$PREFLIGHT_ROOT" in
  "$REMOTE_PATH"/images/.agentscope-cutover-preflight.*) ;;
  *) die "remote preflight directory escaped images boundary" ;;
esac
if ! (
  cd "$TMP_DIR"
  rsync -azR \
    -e "$(rsync_ssh_command)" \
    ./scripts/agentscope_atomic_cutover.py \
    ./app/__init__.py \
    ./app/runtime/__init__.py \
    ./app/runtime/sqlite_schema_contract.py \
    "${REMOTE}:$(quote "$PREFLIGHT_ROOT")/"
); then
  remote_run "bash -s -- $(quote "$REMOTE_PATH") $(quote "$PREFLIGHT_ROOT")" <<'REMOTE_PREFLIGHT_CLEANUP'
set -euo pipefail
remote_path=$1
preflight_root=$2
case "$preflight_root" in
  "$remote_path"/images/.agentscope-cutover-preflight.*) rm -rf -- "$preflight_root" ;;
  *) printf 'Refusing unsafe preflight cleanup.\n' >&2; exit 1 ;;
esac
REMOTE_PREFLIGHT_CLEANUP
  die "failed to upload remote Runtime epoch preflight bundle"
fi
remote_run "bash -s -- $(quote "$REMOTE_PATH") $(quote "$PREFLIGHT_ROOT")" <<'REMOTE_EPOCH_PREFLIGHT'
set -euo pipefail
remote_path=$1
preflight_root=$2
case "$preflight_root" in
  "$remote_path"/images/.agentscope-cutover-preflight.*) ;;
  *) printf 'Preflight directory escaped images boundary.\n' >&2; exit 1 ;;
esac
preflight_script="$preflight_root/scripts/agentscope_atomic_cutover.py"
trap 'rm -rf -- "$preflight_root"' EXIT
if [ -f "$remote_path/docker/.env" ]; then
  PYTHONPATH="$preflight_root" python3 "$preflight_script" inspect \
    --env-file "$remote_path/docker/.env" \
    --require-current-or-empty
else
  printf 'No remote docker/.env; treating this as a new installation.\n'
fi
REMOTE_EPOCH_PREFLIGHT

SOURCE_ARTIFACT_SHA256=$(PYTHONPATH="$TMP_DIR" python3 -c \
  'import sys; from pathlib import Path; from scripts.agentscope_atomic_cutover_bootstrap import source_artifact_sha256; print(source_artifact_sha256(Path(sys.argv[1])))' \
  "$TMP_DIR")
[[ "$SOURCE_ARTIFACT_SHA256" =~ ^[0-9a-f]{64}$ ]] || die "failed to compute source artifact SHA-256"
log "Preparing digest-pinned build and runtime dependency images"
"$ROOT_DIR/.venv/bin/python" "$TMP_DIR/scripts/run_selected_env_operation.py" \
  --env-file "$LOCAL_COMPOSE_ENV_PATH" \
  --env-base-dir "$(dirname "$LOCAL_COMPOSE_ENV_PATH")" \
  --operation images-prepare
log "Building project images for version $VERSION"
"$ROOT_DIR/.venv/bin/python" "$TMP_DIR/scripts/run_selected_env_operation.py" \
  --env-file "$LOCAL_COMPOSE_ENV_PATH" \
  --env-base-dir "$(dirname "$LOCAL_COMPOSE_ENV_PATH")" \
  --operation build

PROJECT_IMAGES=(
  "agent-gov-agentscope-runtime:${VERSION}"
  "agent-gov-api:${VERSION}"
  "agent-gov-ui:${VERSION}"
)
for image in "${PROJECT_IMAGES[@]}"; do
  ensure_local_image "$image"
  source_label=$("${LOCAL_DOCKER[@]}" image inspect "$image" --format '{{ index .Config.Labels "io.agentgov.source-artifact-sha256" }}')
  [[ "$source_label" = "$SOURCE_ARTIFACT_SHA256" ]] || die "project image source artifact label mismatch: $image"
done

log "Syncing ${DEPLOY_REF} tracked code"
rsync -az --delete \
  -e "$(rsync_ssh_command)" \
  --exclude='/.git/' \
  --exclude='/images/' \
  --exclude='/docker/.env' \
  --exclude='/docker/.env.bak-*' \
  --exclude='/docker/.env.local-debug' \
  --exclude='/frontend/.env.local' \
  "$TMP_DIR"/ "${REMOTE}:${REMOTE_PATH}/"

remote_run "bash -s -- $(quote "$REMOTE_PATH")" <<'REMOTE_SYNC'
set -euo pipefail
remote_path=$1
cd "$remote_path"
mkdir -p images
cp -n docker/.env.example docker/.env
printf 'remote VERSION=%s\n' "$(tr -d '[:space:]' < VERSION)"
REMOTE_SYNC

log "Validating remote deployment environment before image packaging"
remote_run "cd $(quote "$REMOTE_PATH") && python3 scripts/check_public_bind.py --env-file docker/.env"

log "Resolving Langfuse dependency image names from remote docker/.env"
dependency_images_output=$(remote_run "bash -s -- $(quote "$REMOTE_PATH")" <<'REMOTE_IMAGES'
set -euo pipefail
remote_path=$1
cd "$remote_path"

env_value() {
  local key=$1
  local default=$2
  local value
  value=$(awk -F= -v key="$key" '
    $1 ~ ("^[[:space:]]*(export[[:space:]]+)?" key "[[:space:]]*$") {
      sub(/^[^=]*=/, "")
      sub(/[[:space:]]+#.*$/, "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      gsub(/^["\047]|["\047]$/, "")
      print
      exit
    }
  ' docker/.env 2>/dev/null || true)
  printf '%s\n' "${value:-$default}"
}

langfuse_enabled=$(env_value LANGFUSE_ENABLED false)
case "${langfuse_enabled,,}" in
  true|1|yes|on|t|y) ;;
  false|0|no|off|f|n) exit 0 ;;
  *) echo "LANGFUSE_ENABLED must be a boolean" >&2; exit 1 ;;
esac
case "$(env_value LANGFUSE_BASE_URL http://langfuse-web:3000)" in
  http://langfuse-web:3000|http://langfuse-web:3000/) ;;
  *) exit 0 ;;
esac

env_value LANGFUSE_WORKER_IMAGE docker.io/langfuse/langfuse-worker:3.225.7@sha256:93207bd67d2e789ea55fa3d47eeba065dd6b1869187127ab24201784c52b96bc
env_value LANGFUSE_WEB_IMAGE docker.io/langfuse/langfuse:3.225.7@sha256:a27fe525f52984fa6d36fd34e8b8c6e5ae4af43f34134cafc833b467fa9580ae
env_value LANGFUSE_POSTGRES_IMAGE docker.io/postgres:17.9@sha256:347bc4e64006d47bb255b0e28652d08590260a5e97f6b55f6ba1c0b31aef58b3
env_value LANGFUSE_CLICKHOUSE_IMAGE docker.io/clickhouse/clickhouse-server:24.3.18.7@sha256:85b97f63dcfff47790d26bb5d5801637aaddb2b93e5e9aee27a686c2fb2b9916
env_value LANGFUSE_REDIS_IMAGE docker.io/redis:7.4.9@sha256:3e1b24a1a8f24ff926b15e5ace8c38a03e5657fb66e1fc7e5188e315aa5fa094
env_value LANGFUSE_MINIO_IMAGE cgr.dev/chainguard/minio@sha256:f2cbe739b01145a88176b1b6949fc0d0f568f24dbf27fa801795372d70aab38e
REMOTE_IMAGES
)
mapfile -t DEPENDENCY_IMAGES <<< "$dependency_images_output"
mapfile -t DEPENDENCY_IMAGES < <(dedupe_images "${DEPENDENCY_IMAGES[@]}")
for image in "${DEPENDENCY_IMAGES[@]}"; do
  ensure_local_image "$image"
done

for image in "${PROJECT_IMAGES[@]}" "${DEPENDENCY_IMAGES[@]}"; do
  [[ -n "$image" ]] || continue
  image_os=$("${LOCAL_DOCKER[@]}" image inspect "$image" --format '{{.Os}}')
  image_arch=$(normalize_architecture "$("${LOCAL_DOCKER[@]}" image inspect "$image" --format '{{.Architecture}}')")
  [[ "$image_os" = linux && "$image_arch" = "$LOCAL_DOCKER_ARCH" ]] || die \
    "image platform mismatch before transfer: $image resolves to $image_os/$image_arch, expected linux/$LOCAL_DOCKER_ARCH"
done

PROJECT_ARCHIVE="agent-gov-${VERSION}-images.tar.gz"
DEPENDENCY_ARCHIVE="agent-gov-${VERSION}-langfuse-deps-images.tar.gz"
upload_image_archive "$PROJECT_ARCHIVE" "${PROJECT_IMAGES[@]}"
with_langfuse=0
if (( ${#DEPENDENCY_IMAGES[@]} > 0 )); then
  upload_image_archive "$DEPENDENCY_ARCHIVE" "${DEPENDENCY_IMAGES[@]}"
  with_langfuse=1
fi

log "Loading images and restarting all agent-gov services on $REMOTE"
remote_run "bash -s -- $(quote "$REMOTE_PATH") $(quote "$VERSION") $with_langfuse $(quote "$SOURCE_ARTIFACT_SHA256")" <<'REMOTE_DEPLOY'
set -euo pipefail
remote_path=$1
version=$2
with_langfuse=$3
source_digest=$4
cd "$remote_path"
trusted_path=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH=$trusted_path
unset DOCKER_CONTEXT DOCKER_CERT_PATH DOCKER_TLS_VERIFY COMPOSE_FILE COMPOSE_PROFILES COMPOSE_PROJECT_NAME
docker_boundary=$(mktemp -d /tmp/agentgov-deploy-docker-boundary.XXXXXX)
docker_config="$docker_boundary/docker-config"
plugin_directory="$docker_config/cli-plugins"
install -d -m 0700 "$docker_config" "$plugin_directory"
source_cli=/usr/bin/docker
[ -f "$source_cli" ] || source_cli=/usr/local/bin/docker
[ -f "$source_cli" ] && [ ! -L "$source_cli" ] || { echo "trusted Docker CLI is invalid" >&2; exit 1; }
for source_plugin in \
  /usr/local/lib/docker/cli-plugins/docker-compose \
  /usr/local/libexec/docker/cli-plugins/docker-compose \
  /usr/lib/docker/cli-plugins/docker-compose \
  /usr/libexec/docker/cli-plugins/docker-compose; do
  [ ! -f "$source_plugin" ] || break
done
[ -f "$source_plugin" ] && [ ! -L "$source_plugin" ] || { echo "trusted Compose plugin is invalid" >&2; exit 1; }
source_cli_owner=$(stat -Lc '%u' "$source_cli")
source_cli_mode=$(stat -Lc '%a' "$source_cli")
source_plugin_owner=$(stat -Lc '%u' "$source_plugin")
source_plugin_mode=$(stat -Lc '%a' "$source_plugin")
[ "$source_cli_owner" = 0 ] && [ "$source_plugin_owner" = 0 ] && \
  (( (8#$source_cli_mode & 8#022) == 0 )) && (( (8#$source_plugin_mode & 8#022) == 0 )) || {
  echo "trusted Docker CLI/plugin owner/mode is invalid" >&2
  exit 1
}
source_cli_sha=$(sha256sum "$source_cli" | awk '{print $1}')
source_plugin_sha=$(sha256sum "$source_plugin" | awk '{print $1}')
install -m 0500 "$source_cli" "$docker_boundary/docker"
install -m 0500 "$source_plugin" "$plugin_directory/docker-compose"
chmod 0500 "$plugin_directory" "$docker_boundary"
[ "$(sha256sum "$source_cli" | awk '{print $1}')" = "$source_cli_sha" ] && \
  [ "$(sha256sum "$source_plugin" | awk '{print $1}')" = "$source_plugin_sha" ] && \
  [ "$(sha256sum "$docker_boundary/docker" | awk '{print $1}')" = "$source_cli_sha" ] && \
  [ "$(sha256sum "$plugin_directory/docker-compose" | awk '{print $1}')" = "$source_plugin_sha" ] || {
  echo "Docker CLI/plugin changed while binding" >&2
  exit 1
}
trap 'rm -rf -- "$docker_boundary"' EXIT
docker_cmd=(env -i HOME="$HOME" DOCKER_CONFIG="$docker_config" PATH="$docker_boundary:$trusted_path" DOCKER_HOST=unix:///var/run/docker.sock "$docker_boundary/docker")

normalize_architecture() {
  case "$1" in
    amd64|x86_64) printf 'amd64\n' ;;
    arm64|aarch64) printf 'arm64\n' ;;
    *) printf '%s\n' "$1" ;;
  esac
}
remote_arch=$(normalize_architecture "$("${docker_cmd[@]}" info --format '{{.Architecture}}')")

project_archive="images/agent-gov-${version}-images.tar.gz"
dependency_archive="images/agent-gov-${version}-langfuse-deps-images.tar.gz"
archives=("$project_archive")
[ "$with_langfuse" = 0 ] || archives+=("$dependency_archive")
for archive in "${archives[@]}"; do
  [ -f "$archive" ] || { echo "missing archive: $archive" >&2; exit 1; }
  [ -f "$archive.sha256" ] || { echo "missing checksum: $archive.sha256" >&2; exit 1; }
  sha256sum -c "$archive.sha256"
done

python3 scripts/agentscope_atomic_cutover_archive.py \
  --archive "$project_archive" \
  --architecture "$remote_arch" \
  --source-digest "$source_digest" \
  --expected-image "agent-gov-agentscope-runtime:${version}" \
  --expected-image "agent-gov-api:${version}" \
  --expected-image "agent-gov-ui:${version}"
if [ "$with_langfuse" = 1 ]; then
  python3 scripts/agentscope_atomic_cutover_archive.py \
    --archive "$dependency_archive" \
    --architecture "$remote_arch" \
    --forbidden-prefix agent-gov-
fi
for archive in "${archives[@]}"; do
  gzip -dc "$archive" | "${docker_cmd[@]}" load
done

actual_source_digest=$(python3 -c \
  'from pathlib import Path; from scripts.agentscope_atomic_cutover_bootstrap import source_artifact_sha256; print(source_artifact_sha256(Path.cwd()))')
[ "$actual_source_digest" = "$source_digest" ] || {
  echo "remote source artifact differs from freshly built project images" >&2
  exit 1
}
for image in "agent-gov-agentscope-runtime:${version}" "agent-gov-api:${version}" "agent-gov-ui:${version}"; do
  source_label=$("${docker_cmd[@]}" image inspect "$image" --format '{{ index .Config.Labels "io.agentgov.source-artifact-sha256" }}')
  [ "$source_label" = "$source_digest" ] || {
    echo "loaded project image source artifact label mismatch: $image" >&2
    exit 1
  }
done

export APP_VERSION="$version"
export AGENTGOV_SOURCE_ARTIFACT_SHA256="$source_digest"

[ -f docker/.env ] && [ ! -L docker/.env ] || { echo "docker/.env must be a regular non-symlink file" >&2; exit 1; }
source_env_sha256=$(sha256sum docker/.env | awk '{print $1}')
source_env_identity=$(stat -Lc '%d:%i:%s:%Y:%Z' docker/.env)
selected_env=$(mktemp /tmp/agentgov-deploy-env.XXXXXX)
trap 'rm -f -- "$selected_env"; rm -rf -- "$docker_boundary"' EXIT
install -m 0600 docker/.env "$selected_env"
export SELECTED_DEPLOY_ENV_FILE=$selected_env

read_env() {
  local key=$1
  local default=$2
  local value
  value=$(awk -F= -v key="$key" '
    $1 == key {
      sub(/^[^=]*=/, "")
      sub(/[[:space:]]+#.*$/, "")
      gsub(/^"|"$/, "")
      print
      exit
    }
  ' "${SELECTED_DEPLOY_ENV_FILE:-docker/.env}" 2>/dev/null || true)
  printf '%s' "${value:-$default}"
}

expand_remote_value() {
  local value=$1
  value=${value//\$\{HOME\}/$HOME}
  value=${value//\$HOME/$HOME}
  value=${value/#\~/$HOME}
  printf '%s' "$value"
}

for required_key in API_KEY AGENTGOV_RUNTIME_SHARED_SECRET MODEL_PROVIDER_API_KEY; do
  required_value=$(read_env "$required_key" "")
  [ -n "$required_value" ] || { echo "missing required private env key: $required_key" >&2; exit 1; }
  case "$required_value" in
    change-me|replace-with-*)
      echo "placeholder private env value is forbidden: $required_key" >&2
      exit 1
      ;;
  esac
done

if [ "$with_langfuse" = 1 ]; then
  required_langfuse_keys=(
    LANGFUSE_PUBLIC_KEY LANGFUSE_SECRET_KEY \
    LANGFUSE_SALT LANGFUSE_NEXTAUTH_SECRET LANGFUSE_POSTGRES_PASSWORD \
    LANGFUSE_CLICKHOUSE_PASSWORD LANGFUSE_REDIS_AUTH \
    LANGFUSE_MINIO_ROOT_PASSWORD
  )
  [ -z "$(read_env LANGFUSE_INIT_USER_EMAIL "")" ] || required_langfuse_keys+=(LANGFUSE_INIT_USER_PASSWORD)
  for required_key in "${required_langfuse_keys[@]}"; do
    required_value=$(read_env "$required_key" "")
    [ ${#required_value} -ge 16 ] || { echo "Langfuse private env value is too short: $required_key" >&2; exit 1; }
    case "$required_value" in
      change-me*|replace-with-*|*agentgov-local*|langfuse-*|minio)
        echo "placeholder Langfuse env value is forbidden: $required_key" >&2
        exit 1
        ;;
    esac
  done

  encryption_key=$(read_env LANGFUSE_ENCRYPTION_KEY "")
  case "$encryption_key" in
    *[!0-9a-f]*|'')
      echo "LANGFUSE_ENCRYPTION_KEY must be exactly 64 lowercase hex characters" >&2
      exit 1
      ;;
  esac
  [ ${#encryption_key} -eq 64 ] && [ "$encryption_key" != "$(printf '0%.0s' {1..64})" ] || {
    echo "LANGFUSE_ENCRYPTION_KEY must be exactly 64 nonzero lowercase hex characters" >&2
    exit 1
  }

  langfuse_bind_ip=$(read_env LANGFUSE_BIND_IP 127.0.0.1)
  case "$langfuse_bind_ip" in
    127.0.0.1|localhost|::1) ;;
    *)
      [ "$(read_env LANGFUSE_ALLOW_PUBLIC_BIND 0)" = "1" ] || {
        echo "public Langfuse bind requires LANGFUSE_ALLOW_PUBLIC_BIND=1 and an operator-provided TLS reverse proxy" >&2
        exit 1
      }
      ;;
  esac
fi

require_public_bind_opt_in() {
  local label=$1
  local bind_key=$2
  local allow_key=$3
  local bind_ip
  bind_ip=$(read_env "$bind_key" 127.0.0.1)
  case "$bind_ip" in
    127.0.0.1|localhost|::1) ;;
    *)
      [ "$(read_env "$allow_key" 0)" = "1" ] || {
        echo "public $label bind requires $allow_key=1; AgentGov is a single-tenant operator control plane without cross-user isolation" >&2
        exit 1
      }
      ;;
  esac
}

require_public_bind_opt_in "AgentGov API" API_BIND_IP API_ALLOW_PUBLIC_BIND
require_public_bind_opt_in "AgentGov UI" FRONTEND_BIND_IP FRONTEND_ALLOW_PUBLIC_BIND

# 普通部署只能复用空卷或精确 AgentScope epoch。旧 Claude/未知 schema 必须在仍未停服时
# fail closed，绝不能把一次版本部署偷换成 destructive cutover。
env -i HOME="$HOME" PATH="$trusted_path" python3 scripts/agentscope_atomic_cutover.py inspect \
  --env-file "$selected_env" \
  --require-current-or-empty

if [ "$with_langfuse" = 1 ]; then
  .venv/bin/python scripts/run_selected_env_operation.py --env-file "$selected_env" \
    --env-base-dir "$remote_path/docker" --operation all-up --no-build --force-recreate
else
  .venv/bin/python scripts/run_selected_env_operation.py --env-file "$selected_env" \
    --env-base-dir "$remote_path/docker" --operation up --no-build --force-recreate
fi

[ "$(sha256sum "$docker_boundary/docker" | awk '{print $1}')" = "$source_cli_sha" ] && \
  [ "$(sha256sum "$plugin_directory/docker-compose" | awk '{print $1}')" = "$source_plugin_sha" ] || {
  echo "bound Docker CLI/plugin changed during deployment" >&2
  exit 1
}

[ "$(sha256sum docker/.env | awk '{print $1}')" = "$source_env_sha256" ] && \
  [ "$(stat -Lc '%d:%i:%s:%Y:%Z' docker/.env)" = "$source_env_identity" ] || {
  echo "docker/.env changed during the deployment transaction" >&2
  exit 1
}
[ "$(python3 -c 'from pathlib import Path; from scripts.agentscope_atomic_cutover_bootstrap import source_artifact_sha256; print(source_artifact_sha256(Path.cwd()))')" = "$source_digest" ] || {
  echo "deployable source changed during the deployment transaction" >&2
  exit 1
}

host_port=$(expand_remote_value "$(read_env HOST_PORT 50400)")
frontend_port=$(expand_remote_value "$(read_env FRONTEND_HOST_PORT 50401)")
langfuse_port=$(expand_remote_value "$(read_env LANGFUSE_HOST_PORT 50402)")

python3 - <<PY
from urllib.error import HTTPError
from urllib.request import ProxyHandler, Request, build_opener
import time

direct_http = build_opener(ProxyHandler({}))

checks = [
    ("API and AgentScope Runtime readiness", "http://127.0.0.1:${host_port}/health/ready", 60, True),
    ("UI", "http://127.0.0.1:${frontend_port}", 60, False),
]
if ${with_langfuse}:
    checks.append(("Langfuse", "http://127.0.0.1:${langfuse_port}", 90, False))

for name, url, attempts, print_body in checks:
    last_error = None
    for _ in range(attempts):
        try:
            request = Request(url, headers={"User-Agent": "agent-gov-deploy-smoke"})
            with direct_http.open(request, timeout=5) as response:
                body = response.read(500)
                print(f"{name} OK: {url} status={response.status}")
                if print_body:
                    print(body.decode("utf-8", "replace"))
                break
        except HTTPError as exc:
            last_error = RuntimeError(f"HTTP {exc.code}: {exc.read(500).decode('utf-8', 'replace')}")
            time.sleep(2)
        except Exception as exc:  # noqa: BLE001 - remote smoke reports final failure text.
            last_error = exc
            time.sleep(2)
    else:
        raise SystemExit(f"{name} failed: {url}: {last_error!r}")
PY
REMOTE_DEPLOY

log "Deployment completed on ${REMOTE}:${REMOTE_PATH}"
