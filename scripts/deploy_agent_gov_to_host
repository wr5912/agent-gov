#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
DEFAULT_HOST="172.16.112.232"
DEFAULT_REMOTE_DIR="~/work/agent-gov"
COMPOSE_FILE="docker/docker-compose.yml"
LOCAL_COMPOSE_ENV_FILE="${LOCAL_COMPOSE_ENV_FILE:-docker/.env}"

usage() {
  cat <<'USAGE'
Usage: scripts/deploy_agent_gov_to_host [host]

Deploy latest origin/master to a remote Docker Compose host.

Defaults:
  host        172.16.112.232
  user        root          (override with DEPLOY_USER)
  remote dir  ~/work/agent-gov (override with REMOTE_DIR)

The script preserves the remote private docker/.env, stores image archives in
remote images/, loads the images on the remote host, replaces this Compose
project, starts the core stack and locally configured Langfuse, and validates
the selected endpoints. External Langfuse needs no local storage credentials.
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if (( $# > 1 )); then
  usage >&2
  exit 2
fi

DEPLOY_HOST="${1:-${DEPLOY_HOST:-$DEFAULT_HOST}}"
DEPLOY_USER="${DEPLOY_USER:-root}"
REMOTE_DIR="${REMOTE_DIR:-$DEFAULT_REMOTE_DIR}"
REMOTE="${DEPLOY_USER}@${DEPLOY_HOST}"
SSH_CONNECT_TIMEOUT="${SSH_CONNECT_TIMEOUT:-10}"
SSH_OPTIONS=(
  -o StrictHostKeyChecking=accept-new
  -o BatchMode=yes
  -o "ConnectTimeout=${SSH_CONNECT_TIMEOUT}"
)

log() {
  printf '[deploy] %s\n' "$*"
}

die() {
  printf '[deploy] ERROR: %s\n' "$*" >&2
  exit 1
}

quote() {
  printf '%q' "$1"
}

remote_run() {
  ssh "${SSH_OPTIONS[@]}" "$REMOTE" "$@"
}

rsync_ssh_command() {
  local command="ssh"
  local option
  for option in "${SSH_OPTIONS[@]}"; do
    command+=" $(quote "$option")"
  done
  printf '%s' "$command"
}

require_command() {
  local name=$1
  command -v "$name" >/dev/null 2>&1 || die "required command not found: $name"
}

fetch_origin_master() {
  git fetch origin master --prune --tags

  ORIGIN_MASTER=$(git rev-parse origin/master)
  VERSION=$(git show origin/master:VERSION | tr -d '[:space:]')
  [[ -n "$VERSION" ]] || die "origin/master VERSION is empty"
}

ensure_local_image() {
  local image=$1
  if docker image inspect "$image" >/dev/null 2>&1; then
    return 0
  fi

  log "Local image missing, pulling: $image"
  docker pull "$image"
}

dedupe_images() {
  local image
  declare -A seen=()
  for image in "$@"; do
    [[ -n "$image" ]] || continue
    if [[ -z "${seen[$image]+x}" ]]; then
      seen[$image]=1
      printf '%s\n' "$image"
    fi
  done
}

upload_image_archive() {
  local archive=$1
  shift
  local images=("$@")

  log "Writing remote image archive: images/$archive"
  docker save "${images[@]}" | gzip -1 | remote_run "bash -c 'set -euo pipefail
    remote_path=\$1
    archive=\$2
    mkdir -p \"\$remote_path/images\"
    cat > \"\$remote_path/images/\${archive}.tmp\"
    mv \"\$remote_path/images/\${archive}.tmp\" \"\$remote_path/images/\$archive\"
    sha256sum \"\$remote_path/images/\$archive\" > \"\$remote_path/images/\$archive.sha256\"
    ls -lh \"\$remote_path/images/\$archive\"
    cat \"\$remote_path/images/\$archive.sha256\"
  ' bash $(quote "$REMOTE_PATH") $(quote "$archive")"
}

cd "$ROOT_DIR"

for command_name in git docker gzip rsync ssh tar; do
  require_command "$command_name"
done

[[ -f VERSION ]] || die "VERSION file not found"
[[ -f "$COMPOSE_FILE" ]] || die "$COMPOSE_FILE not found"

log "Consumer x Mode x Boundary: remote containers use docker/.env, runtime root stays on the remote host, secrets stay in private env files"
fetch_origin_master

TMP_DIR=$(mktemp -d /tmp/agent-gov-master.XXXXXX)
trap 'rm -rf "$TMP_DIR"' EXIT

log "Exporting origin/master ${ORIGIN_MASTER}"
git archive origin/master | tar -x -C "$TMP_DIR"

if [[ "$LOCAL_COMPOSE_ENV_FILE" = /* ]]; then
  LOCAL_COMPOSE_ENV_PATH="$LOCAL_COMPOSE_ENV_FILE"
else
  LOCAL_COMPOSE_ENV_PATH="$ROOT_DIR/$LOCAL_COMPOSE_ENV_FILE"
fi

if [[ ! -f "$LOCAL_COMPOSE_ENV_PATH" ]]; then
  LOCAL_COMPOSE_ENV_PATH="$TMP_DIR/docker/.env.example"
  log "$LOCAL_COMPOSE_ENV_FILE not found; using origin/master docker/.env.example for local build interpolation"
fi
[[ -f "$LOCAL_COMPOSE_ENV_PATH" ]] || die "compose env file not found"

log "Checking remote prerequisites on $REMOTE"
remote_run "bash -s" <<'REMOTE_PREREQUISITES'
set -euo pipefail
command -v python3 >/dev/null || { echo "remote python3 is required" >&2; exit 1; }
command -v docker >/dev/null || { echo "remote docker is required" >&2; exit 1; }
docker compose version >/dev/null
python3 - <<'PY'
import sys

if sys.version_info < (3, 11):
    raise SystemExit(f"remote Python >=3.11 is required, found {sys.version.split()[0]}")
PY
REMOTE_PREREQUISITES

REMOTE_PATH=$(remote_run "REMOTE_DIR=$(quote "$REMOTE_DIR") python3 - <<'PY'
import os

print(os.path.abspath(os.path.expanduser(os.environ['REMOTE_DIR'])))
PY
")
[[ -n "$REMOTE_PATH" ]] || die "failed to resolve remote path"

log "Remote path: $REMOTE:$REMOTE_PATH"
remote_run "mkdir -p $(quote "$REMOTE_PATH") $(quote "$REMOTE_PATH/images")"

# 在 rsync 覆盖旧栈 Compose/脚本之前，只读检查远程 schema epoch。临时检查器放在
# images/ 中（该目录不参与代码 rsync），无论成功还是失败都删除。
log "Preflighting remote Runtime epoch before source sync"
rsync -az \
  -e "$(rsync_ssh_command)" \
  "$TMP_DIR/scripts/agentscope_atomic_cutover.py" \
  "${REMOTE}:${REMOTE_PATH}/images/.agentscope_atomic_cutover.preflight.py"
remote_run "bash -s -- $(quote "$REMOTE_PATH")" <<'REMOTE_EPOCH_PREFLIGHT'
set -euo pipefail
remote_path=$1
preflight_script="$remote_path/images/.agentscope_atomic_cutover.preflight.py"
trap 'rm -f "$preflight_script"' EXIT
if [ -f "$remote_path/docker/.env" ]; then
  python3 "$preflight_script" inspect \
    --env-file "$remote_path/docker/.env" \
    --require-current-or-empty
else
  printf 'No remote docker/.env; treating this as a new installation.\n'
fi
REMOTE_EPOCH_PREFLIGHT

log "Building project images for version $VERSION"
APP_VERSION="$VERSION" docker compose --env-file "$LOCAL_COMPOSE_ENV_PATH" -f "$TMP_DIR/$COMPOSE_FILE" build \
  agentscope-runtime \
  agent-gov-api \
  agent-gov-ui

PROJECT_IMAGES=(
  "agent-gov-agentscope-runtime:${VERSION}"
  "agent-gov-api:${VERSION}"
  "agent-gov-ui:${VERSION}"
)
for image in "${PROJECT_IMAGES[@]}"; do
  ensure_local_image "$image"
done

log "Syncing origin/master tracked code"
rsync -az --delete \
  -e "$(rsync_ssh_command)" \
  --exclude='/.git/' \
  --exclude='/images/' \
  --exclude='/docker/.env' \
  --exclude='/docker/.env.bak-*' \
  --exclude='/docker/.env.local-debug' \
  --exclude='/frontend/.env.local' \
  "$TMP_DIR"/ "${REMOTE}:${REMOTE_PATH}/"

remote_run "bash -s -- $(quote "$REMOTE_PATH")" <<'REMOTE_SYNC'
set -euo pipefail
remote_path=$1
cd "$remote_path"
mkdir -p images
cp -n docker/.env.example docker/.env
printf 'remote VERSION=%s\n' "$(tr -d '[:space:]' < VERSION)"
REMOTE_SYNC

log "Resolving Langfuse dependency image names from remote docker/.env"
dependency_images_output=$(remote_run "bash -s -- $(quote "$REMOTE_PATH")" <<'REMOTE_IMAGES'
set -euo pipefail
remote_path=$1
cd "$remote_path"

env_value() {
  local key=$1
  local default=$2
  local value
  value=$(awk -F= -v key="$key" '
    $1 ~ ("^[[:space:]]*(export[[:space:]]+)?" key "[[:space:]]*$") {
      sub(/^[^=]*=/, "")
      sub(/[[:space:]]+#.*$/, "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      gsub(/^["\047]|["\047]$/, "")
      print
      exit
    }
  ' docker/.env 2>/dev/null || true)
  printf '%s\n' "${value:-$default}"
}

langfuse_enabled=$(env_value LANGFUSE_ENABLED false)
case "${langfuse_enabled,,}" in
  true|1|yes|on|t|y) ;;
  false|0|no|off|f|n) exit 0 ;;
  *) echo "LANGFUSE_ENABLED must be a boolean" >&2; exit 1 ;;
esac
case "$(env_value LANGFUSE_BASE_URL http://langfuse-web:3000)" in
  http://langfuse-web:3000|http://langfuse-web:3000/) ;;
  *) exit 0 ;;
esac

env_value LANGFUSE_WORKER_IMAGE docker.io/langfuse/langfuse-worker:3
env_value LANGFUSE_WEB_IMAGE docker.io/langfuse/langfuse:3
env_value LANGFUSE_POSTGRES_IMAGE docker.io/postgres:17
env_value LANGFUSE_CLICKHOUSE_IMAGE docker.io/clickhouse/clickhouse-server:24.3
env_value LANGFUSE_REDIS_IMAGE docker.io/redis:7
env_value LANGFUSE_MINIO_IMAGE cgr.dev/chainguard/minio
REMOTE_IMAGES
)
mapfile -t DEPENDENCY_IMAGES <<< "$dependency_images_output"
mapfile -t DEPENDENCY_IMAGES < <(dedupe_images "${DEPENDENCY_IMAGES[@]}")
for image in "${DEPENDENCY_IMAGES[@]}"; do
  ensure_local_image "$image"
done

PROJECT_ARCHIVE="agent-gov-${VERSION}-images.tar.gz"
DEPENDENCY_ARCHIVE="agent-gov-${VERSION}-langfuse-deps-images.tar.gz"
upload_image_archive "$PROJECT_ARCHIVE" "${PROJECT_IMAGES[@]}"
with_langfuse=0
if (( ${#DEPENDENCY_IMAGES[@]} > 0 )); then
  upload_image_archive "$DEPENDENCY_ARCHIVE" "${DEPENDENCY_IMAGES[@]}"
  with_langfuse=1
fi

log "Loading images and restarting all agent-gov services on $REMOTE"
remote_run "bash -s -- $(quote "$REMOTE_PATH") $(quote "$VERSION") $with_langfuse" <<'REMOTE_DEPLOY'
set -euo pipefail
remote_path=$1
version=$2
with_langfuse=$3
cd "$remote_path"

project_archive="images/agent-gov-${version}-images.tar.gz"
dependency_archive="images/agent-gov-${version}-langfuse-deps-images.tar.gz"
archives=("$project_archive")
[ "$with_langfuse" = 0 ] || archives+=("$dependency_archive")
for archive in "${archives[@]}"; do
  [ -f "$archive" ] || { echo "missing archive: $archive" >&2; exit 1; }
  [ -f "$archive.sha256" ] || { echo "missing checksum: $archive.sha256" >&2; exit 1; }
  sha256sum -c "$archive.sha256"
  gzip -dc "$archive" | docker load
done

read_env() {
  local key=$1
  local default=$2
  local value
  value=$(awk -F= -v key="$key" '
    $1 == key {
      sub(/^[^=]*=/, "")
      sub(/[[:space:]]+#.*$/, "")
      gsub(/^"|"$/, "")
      print
      exit
    }
  ' docker/.env 2>/dev/null || true)
  printf '%s' "${value:-$default}"
}

expand_remote_value() {
  local value=$1
  value=${value//\$\{HOME\}/$HOME}
  value=${value//\$HOME/$HOME}
  value=${value/#\~/$HOME}
  printf '%s' "$value"
}

export APP_VERSION="$version"
for required_key in API_KEY AGENTGOV_RUNTIME_SHARED_SECRET MODEL_PROVIDER_API_KEY; do
  required_value=$(read_env "$required_key" "")
  [ -n "$required_value" ] || { echo "missing required private env key: $required_key" >&2; exit 1; }
  case "$required_value" in
    change-me|replace-with-*)
      echo "placeholder private env value is forbidden: $required_key" >&2
      exit 1
      ;;
  esac
done

if [ "$with_langfuse" = 1 ]; then
  required_langfuse_keys=(
    LANGFUSE_PUBLIC_KEY LANGFUSE_SECRET_KEY \
    LANGFUSE_SALT LANGFUSE_NEXTAUTH_SECRET LANGFUSE_POSTGRES_PASSWORD \
    LANGFUSE_CLICKHOUSE_PASSWORD LANGFUSE_REDIS_AUTH \
    LANGFUSE_MINIO_ROOT_PASSWORD
  )
  [ -z "$(read_env LANGFUSE_INIT_USER_EMAIL "")" ] || required_langfuse_keys+=(LANGFUSE_INIT_USER_PASSWORD)
  for required_key in "${required_langfuse_keys[@]}"; do
    required_value=$(read_env "$required_key" "")
    [ ${#required_value} -ge 16 ] || { echo "Langfuse private env value is too short: $required_key" >&2; exit 1; }
    case "$required_value" in
      change-me*|replace-with-*|*agentgov-local*|langfuse-*|minio)
        echo "placeholder Langfuse env value is forbidden: $required_key" >&2
        exit 1
        ;;
    esac
  done

  encryption_key=$(read_env LANGFUSE_ENCRYPTION_KEY "")
  case "$encryption_key" in
    *[!0-9a-f]*|'')
      echo "LANGFUSE_ENCRYPTION_KEY must be exactly 64 lowercase hex characters" >&2
      exit 1
      ;;
  esac
  [ ${#encryption_key} -eq 64 ] && [ "$encryption_key" != "$(printf '0%.0s' {1..64})" ] || {
    echo "LANGFUSE_ENCRYPTION_KEY must be exactly 64 nonzero lowercase hex characters" >&2
    exit 1
  }

  langfuse_bind_ip=$(read_env LANGFUSE_BIND_IP 127.0.0.1)
  case "$langfuse_bind_ip" in
    127.0.0.1|localhost|::1) ;;
    *)
      [ "$(read_env LANGFUSE_ALLOW_PUBLIC_BIND 0)" = "1" ] || {
        echo "public Langfuse bind requires LANGFUSE_ALLOW_PUBLIC_BIND=1 and an operator-provided TLS reverse proxy" >&2
        exit 1
      }
      ;;
  esac
fi

require_public_bind_opt_in() {
  local label=$1
  local bind_key=$2
  local allow_key=$3
  local bind_ip
  bind_ip=$(read_env "$bind_key" 127.0.0.1)
  case "$bind_ip" in
    127.0.0.1|localhost|::1) ;;
    *)
      [ "$(read_env "$allow_key" 0)" = "1" ] || {
        echo "public $label bind requires $allow_key=1; AgentGov is a single-tenant operator control plane without cross-user isolation" >&2
        exit 1
      }
      ;;
  esac
}

require_public_bind_opt_in "AgentGov API" API_BIND_IP API_ALLOW_PUBLIC_BIND
require_public_bind_opt_in "AgentGov UI" FRONTEND_BIND_IP FRONTEND_ALLOW_PUBLIC_BIND
compose=(docker compose --env-file docker/.env -f docker/docker-compose.yml)
if [ "$with_langfuse" = 1 ]; then
  compose+=(-f docker/docker-compose.langfuse.yml)
  "${compose[@]}" --profile langfuse config >/dev/null
else
  "${compose[@]}" config >/dev/null
fi
actual_core_services=$(docker compose --env-file docker/.env -f docker/docker-compose.yml config --services | sort)
expected_core_services=$(printf '%s\n' agent-gov-api agent-gov-ui agentscope-runtime | sort)
[ "$actual_core_services" = "$expected_core_services" ] || {
  echo "unexpected core service set before cutover" >&2
  printf 'actual:\n%s\n' "$actual_core_services" >&2
  exit 1
}

# 普通部署只能复用空卷或精确 AgentScope epoch。旧 Claude/未知 schema 必须在仍未停服时
# fail closed，绝不能把一次版本部署偷换成 destructive cutover。
python3 scripts/agentscope_atomic_cutover.py inspect \
  --env-file docker/.env \
  --require-current-or-empty

export COMPOSE_ENV_FILE=docker/.env
export COMPOSE_UP_FLAGS="--no-build --pull never"
if [ "$with_langfuse" = 1 ]; then
  "${compose[@]}" --profile langfuse down --remove-orphans || true
  make --no-print-directory all-up
  "${compose[@]}" --profile langfuse ps
else
  "${compose[@]}" down
  make --no-print-directory up
  "${compose[@]}" ps
fi

actual_core_services=$(docker compose --env-file docker/.env -f docker/docker-compose.yml config --services | sort)
expected_core_services=$(printf '%s\n' agent-gov-api agent-gov-ui agentscope-runtime | sort)
[ "$actual_core_services" = "$expected_core_services" ] || {
  echo "unexpected core service set" >&2
  printf 'actual:\n%s\n' "$actual_core_services" >&2
  exit 1
}

host_port=$(expand_remote_value "$(read_env HOST_PORT 50400)")
frontend_port=$(expand_remote_value "$(read_env FRONTEND_HOST_PORT 50401)")
langfuse_port=$(expand_remote_value "$(read_env LANGFUSE_HOST_PORT 50402)")

python3 - <<PY
from urllib.error import HTTPError
from urllib.request import Request, urlopen
import time

checks = [
    ("API and AgentScope Runtime readiness", "http://127.0.0.1:${host_port}/health/ready", 60, True),
    ("UI", "http://127.0.0.1:${frontend_port}", 60, False),
]
if ${with_langfuse}:
    checks.append(("Langfuse", "http://127.0.0.1:${langfuse_port}", 90, False))

for name, url, attempts, print_body in checks:
    last_error = None
    for _ in range(attempts):
        try:
            request = Request(url, headers={"User-Agent": "agent-gov-deploy-smoke"})
            with urlopen(request, timeout=5) as response:
                body = response.read(500)
                print(f"{name} OK: {url} status={response.status}")
                if print_body:
                    print(body.decode("utf-8", "replace"))
                break
        except HTTPError as exc:
            last_error = RuntimeError(f"HTTP {exc.code}: {exc.read(500).decode('utf-8', 'replace')}")
            time.sleep(2)
        except Exception as exc:  # noqa: BLE001 - remote smoke reports final failure text.
            last_error = exc
            time.sleep(2)
    else:
        raise SystemExit(f"{name} failed: {url}: {last_error!r}")
PY
REMOTE_DEPLOY

log "Deployment completed on ${REMOTE}:${REMOTE_PATH}"
