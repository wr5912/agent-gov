  "gaps": [
    {
      "id": "agentscope-live-cutover-evidence",
      "capability": "runtime-deployment",
      "owner": "runtime-platform",
      "risk": "critical",
      "description": "当前仅有隔离 core smoke 和可执行的显式 opt-in live provider 入口；尚未取得 50 个实质不同 run、10 并发、3 次真实浏览器、2 小时 soak 以及带真实 OTLP secret 的 trace completeness 证据。",
      "target_lane": "container-live-acceptance",
      "issue": "follow-up:agentscope-live-acceptance",
      "acceptance": [
        "准备至少 50 条质量复核后实质不同且不可循环复制的场景，执行 50 个真实 AgentScope run 并验证 session、SSE、canonical message、run、reply、trace 与反馈关联",
        "在隔离临时 Compose project 中以 10 并发执行真实 provider 验收，保存零错配、零丢事件和终态证据",
        "真实浏览器主链连续执行至少 3 次，验证运行、停止、消息、轨迹和反馈交互且不直连 Runtime 管理面",
        "连续运行 2 小时 soak，记录成功率、延迟、资源增长、恢复和清理证据",
        "使用受保护 OTLP secret 验证 agentgov.run 根 span、AgentScope 子 span、必要关联属性、脱敏与 terminal trace_status=complete"
      ]
    }
  ],
